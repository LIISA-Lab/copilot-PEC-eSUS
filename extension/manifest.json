{
  "manifest_version": 3,
  "name": "e-SUS PEC Lens (Risk Stratifier)",
  "version": "0.3.0",
  "description": "Extensão Wasm para estratificação de risco de gestantes no e-SUS PEC.",
  "permissions": [
    "activeTab",
    "scripting",
    "notifications",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://esustreinamento.saude.ce.gov.br/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
"icons": {
  "16": "icons/logo-e-sus.png",
  "32": "icons/logo-e-sus.png",
  "48": "icons/logo-e-sus.png",
  "128": "icons/logo-e-sus.png"
},
"action": {
  "default_title": "Abrir Painel e-SUS Lens",
  "default_icon": {
    "16": "icons/logo-e-sus.png",
    "32": "icons/logo-e-sus.png"
  }
},
  "content_scripts": [
    {
      "matches": [
        "*://esustreinamento.saude.ce.gov.br/*",
        "<all_urls>"
      ],
      "css": [
        "css/sidebar.css"
      ],
      "js": [
        "scripts/idb_helper.js",
        "scripts/domain/risk_criteria.js",
        "scripts/state/store.js",
        "scripts/ui/templates/patient_header.js",
        "scripts/ui/templates/input_risk_data.js",
        "scripts/ui/templates/tab_patient_data.js",
        "scripts/ui/templates/tab_risk_accordion.js",
        "scripts/ui/reopen_button.js",
        "scripts/acesso_saude.js",
        "scripts/ui/pec_banner.js",
        "scripts/ui/sidebar.js",
        "scripts/core/page_injector.js",
        "scripts/core/pec_observer.js",
        "scripts/core/wasm_extractor.js",
        "scripts/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pkg/*",
        "scripts/inject.js",
        "scripts/idb_helper.js"
      ],
      "matches": [
        "*://esustreinamento.saude.ce.gov.br/*",
        "<all_urls>"
      ]
    }
  ]
}
