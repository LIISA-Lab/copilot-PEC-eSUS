{
  "manifest_version": 3,
  "name": "e-SUS PEC Lens (Risk Stratifier)",
  "version": "0.2.1",
  "description": "Extensão Wasm para estratificação de risco de gestantes no e-SUS PEC.",
  "permissions": [
    "activeTab",
    "scripting",
    "notifications",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://esustreinamento.saude.ce.gov.br/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
"icons": {
  "16": "icons/logo-e-sus.png",
  "32": "icons/logo-e-sus.png",
  "48": "icons/logo-e-sus.png",
  "128": "icons/logo-e-sus.png"
},
"action": {
  "default_title": "Abrir Painel e-SUS Lens",
  "default_icon": {
    "16": "icons/logo-e-sus.png",
    "32": "icons/logo-e-sus.png"
  }
},
  "content_scripts": [
    {
      "matches": [
        "*://esustreinamento.saude.ce.gov.br/*",
        "<all_urls>"
      ],
      "js": [
        "scripts/idb_helper.js",
        "scripts/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pkg/*",
        "scripts/inject.js",
        "scripts/idb_helper.js"
      ],
      "matches": ["*://esustreinamento.saude.ce.gov.br/*"]
    }
  ]
}
